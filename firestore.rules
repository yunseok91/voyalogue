rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: trip is publicly shared if its viewCode is registered in shareIndex
    function canReadViaShare(uid, tripId) {
      let t = get(/databases/$(database)/documents/users/$(uid)/trips/$(tripId)).data;
      return t.viewCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(t.viewCode));
    }

    // Helper: trip allows edit writes if its editCode is registered in shareIndex
    function canWriteViaShare(uid, tripId) {
      let t = get(/databases/$(database)/documents/users/$(uid)/trips/$(tripId)).data;
      return t.editCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(t.editCode));
    }

    // User document itself: owner or admin
    match /users/{uid} {
      allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // All nested paths: owner or admin
    match /users/{uid}/{document=**} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // 메시지: 본인 읽기/읽음처리, 인증된 유저 생성(알림 전송), 어드민 삭제
    match /users/{uid}/messages/{msgId} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Share index: public read; authenticated owner-only write
    match /shareIndex/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }

    // Shared trip meta: readable when viewCode is active in shareIndex
    match /users/{uid}/trips/{tripId} {
      allow read: if resource.data.viewCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.viewCode));
      // Member self-registration via invite link (members field only, within people limit)
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members.size() <= resource.data.people;
      // Guest review: authenticated non-owner may write only their own memberReviews entry
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberReviews']) &&
        resource.data.viewCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.viewCode));
      // 총무(멤버): joinCode가 활성 상태일 때 checklist, dayRates 필드 수정 허용
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist', 'dayRates']) &&
        resource.data.joinCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.joinCode));
      // 편집자(editCode): flights, accommodations 수정 허용
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flights', 'accommodations']) &&
        resource.data.editCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.editCode));
      // 총무 뽑기(lotto): 멤버가 자신의 ready 상태 및 vote 업데이트 허용
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lotto']) &&
        resource.data.viewCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.viewCode));
      // 운전자/총무: 운전 경비(drivingCost) 수정 허용 (joinCode가 활성 상태일 때)
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drivingCost']) &&
        resource.data.joinCode is string &&
        exists(/databases/$(database)/documents/shareIndex/$(resource.data.joinCode));
    }

    // Member invite codes: public read, owner write
    match /memberInvites/{code} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // Shared trip days: read via viewCode, write via editCode
    match /users/{uid}/trips/{tripId}/days/{dayId} {
      allow read:  if canReadViaShare(uid, tripId);
      allow write: if canWriteViaShare(uid, tripId);
    }

    // Shared trip items: read via viewCode, write via editCode
    match /users/{uid}/trips/{tripId}/days/{dayId}/items/{itemId} {
      allow read:  if canReadViaShare(uid, tripId);
      allow write: if canWriteViaShare(uid, tripId);
    }

    // Announcements: authenticated users read, admin write
    match /announcements/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Reports: authenticated users create, admin full access
    match /reports/{id} {
      allow create:           if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Admins list: admin read only
    match /admins/{uid} {
      allow read: if isAdmin();
    }

    // Admin collection group read: trips (대시보드 통계용)
    match /{path=**}/trips/{tripId} {
      allow read: if isAdmin();
    }

    // Beta / app-level config: authenticated users read, admin write
    match /config/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // 삭제된 유저 목록: 본인 uid 읽기(재가입 차단 체크), 어드민 write
    match /deletedUsers/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // 탈퇴 요청: 본인 생성, 어드민 전체 접근
    match /deleteRequests/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Service reviews: anyone read, authenticated users create/update own, admin full access
    match /serviceReviews/{id} {
      allow read:   if true;
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'featured', 'createdAt']))
                    || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
