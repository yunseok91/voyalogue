rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 프로필 아바타: 본인만 읽기/쓰기
    match /users/{uid}/avatar {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 영수증: 인증된 사용자라면 업로드 가능, 읽기는 누구나
    match /users/{uid}/trips/{tripId}/receipts/{file} {
      allow write: if request.auth != null;
      allow read:  if true;
    }

    // 운전 경비 영수증: 인증된 사용자라면 업로드 가능, 읽기는 누구나
    match /users/{uid}/trips/{tripId}/drivingCost/{file} {
      allow write: if request.auth != null;
      allow read:  if true;
    }

    // 그 외 본인 경로: 인증된 본인만
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

